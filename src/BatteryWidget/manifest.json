{
  "$schema": "https://schemas.macro-deck.app/plugin-manifest-v1.schema.json",
  "manifestVersion": 1,
  "id": "dev.neon.battery-widget",
  "name": "Battery Widget",
  "version": "1.0.3",
  "description": "Show batteries from the Macro Deck battery catalog in a customizable widget.",
  "icon": "Assets/icon.png",
  "entrypoints": {
    "linux-x64": {
      "executable": "runtimes/linux-x64/BatteryWidget.dll",
      "runtime": { "kind": "FrameworkDependent", "dotnetVersion": "10.0" }
    }
  },
  "publisher": { "name": "Neon" },
  "license": "MIT",
  "repository": "https://github.com/Pix3lM0on/md3-battery-widget",
  "compatibility": { "macroDeck": ">=3.0.4" }
}
